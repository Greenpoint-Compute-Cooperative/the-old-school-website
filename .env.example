# Supabase public API values used by browser-safe request clients.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key. Vercel Functions only; never prefix with PUBLIC or expose in HTML/JS.
SUPABASE_SECRET_KEY=

# Canonical deployment URL, for example https://grove.example.
GROVE_SITE_URL=

# Enable only after each provider is configured and verified in Supabase.
GROVE_INSTAGRAM_OAUTH_ENABLED=false
GROVE_INSTAGRAM_PROVIDER=custom:instagram
GROVE_INSTAGRAM_SCOPES=instagram_business_basic
GROVE_X_OAUTH_ENABLED=false
GROVE_X_PROVIDER=twitter
GROVE_X_SCOPES=users.read

# Keep false until a reviewed checkout/wallet provider and webhook are implemented.
GROVE_ACQUISITION_ENABLED=false

# First-party, session-scoped product metrics. Keep false without the server-only secret.
GROVE_METRICS_ENABLED=false

# Server-only read token for `npm run metrics`; generate at least 32 random bytes.
GROVE_METRICS_READ_TOKEN=

# Server-only Vercel Cron authorization for the 180-day retention job.
CRON_SECRET=

# Operator-only guards for synthetic preview seeding; never set either in Production.
GROVE_SEED_TARGET=
GROVE_PREVIEW_PROJECT_REF=

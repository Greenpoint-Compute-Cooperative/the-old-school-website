{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "images": {
    "sizes": [64, 128, 256, 384, 640, 750, 828, 1080, 1200, 1536],
    "domains": [],
    "localPatterns": [
      {
        "pathname": "^/public/assets/.*\\.(?:avif|jpg|jpeg|png|webp)$",
        "search": ""
      }
    ],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "nlvxepkzrctbjafcgffk.supabase.co",
        "port": "",
        "pathname": "^/storage/v1/object/public/marketplace-media/sha256/[0-9a-f]{64}/.*$",
        "search": ""
      },
      {
        "protocol": "https",
        "hostname": "xscysuvqragqwhxuhivv.supabase.co",
        "port": "",
        "pathname": "^/storage/v1/object/public/marketplace-media/sha256/[0-9a-f]{64}/.*$",
        "search": ""
      }
    ],
    "minimumCacheTTL": 2678400,
    "qualities": [60, 75, 85],
    "formats": ["image/avif", "image/webp"],
    "dangerouslyAllowSVG": false,
    "contentSecurityPolicy": "default-src 'none'; sandbox;",
    "contentDispositionType": "inline"
  },
  "crons": [
    {
      "path": "/api/cron/metrics-retention",
      "schedule": "17 7 * * *"
    },
    {
      "path": "/api/cron/commerce-reconcile",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/auction-close",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/auction-settle",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/nft-delivery",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/opensea-publish",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/resale-index",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/sponsorship-reconcile",
      "schedule": "*/5 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/public/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2678400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' https://fonts.gstatic.com; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: https://nlvxepkzrctbjafcgffk.supabase.co https://xscysuvqragqwhxuhivv.supabase.co; object-src 'none'; script-src 'self'; style-src-elem 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; upgrade-insecure-requests; worker-src 'none'" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-site" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-DNS-Prefetch-Control", "value": "off" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" },
        { "key": "Permissions-Policy", "value": "browsing-topics=(), camera=(), geolocation=(), microphone=(), payment=(), usb=()" }
      ]
    }
  ]
}
